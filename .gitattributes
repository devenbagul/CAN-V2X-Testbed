# Set default behavior for all files (auto-detect text/binary and normalize line endings)
* text=auto

# Explicitly declare text files that should always be normalized to LF on commit
*.py text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.md text eol=lf
*.txt text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Explicitly declare binary files that should not be normalized
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
